# URL gốc của dịch vụ luận giải (Cloudflare Worker).
# Bắt buộc để phần luận giải hoạt động. Thay <subdomain> bằng subdomain của worker.
VITE_API_URL=https://lasotuvi-api.<subdomain>.workers.dev

# Site key Cloudflare Turnstile (chống bot cào data).
# Tạo tại dash.cloudflare.com -> Turnstile -> Add site. Để trống = tắt xác minh.
VITE_TURNSTILE_SITEKEY=